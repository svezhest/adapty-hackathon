# Copy to .env (git-ignored). Never commit the real values.

# Adapty secret API key of the Lumen app (Dashboard → App settings → General → API keys).
# Used for getProfile and grantAccessLevel. Server-side API only; never printed or logged.
ADAPTY_SECRET_KEY=

# Which LLM runs both agents (Level 1 triage, Level 2 chat): auto, openai or anthropic.
# auto = openai when OPENAI_API_KEY and OPENAI_MODEL are set, else anthropic when ANTHROPIC_API_KEY is set.
# The Agent settings page can override it per running app (it never sees the keys).
LLM_PROVIDER=auto

# OpenAI (used when LLM_PROVIDER=openai). The model id comes with the tokens; it has no default
# and is never guessed in code. OPENAI_BASE_URL is optional (an OpenAI-compatible endpoint).
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=
# Provider-specific body fields as JSON, strict tool schemas (1/0), output cap per call:
# OPENAI_EXTRA_BODY=
# OPENAI_STRICT_TOOLS=1
# OPENAI_MAX_TOKENS=4000

# Anthropic (used when LLM_PROVIDER=anthropic). ANTHROPIC_MODEL is optional: empty = the newest
# model whose id contains "opus" in the account's models list.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Jira Cloud, for bug reports to the teams. Leave empty to run without it. Teams and auto-create are in Agent settings.
# The token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Where this app is reachable, for a link from the issue back to the ticket (optional).
# RESOLVE_PUBLIC_URL=

# 1 = serve from the committed SQLite snapshot (data/demo.sqlite) with cached profiles and
# proposals. No keys needed; Approve changes local state only and the UI says so.
DEMO_MODE=0

# Optional overrides (defaults shown).
# ADAPTY_APP_ID=9c49efb6-f2ca-479a-8f57-4bb6c8ea2f41
# ADAPTY_ACCESS_LEVEL=premium
# COMPENSATION_DAYS=7
# RESOLVE_DB=data/resolve.sqlite
